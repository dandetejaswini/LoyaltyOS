
# ==============================================================================
# LoyaltyOS — Intelligent Loyalty & Ledger Management Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# Replace placeholders with your actual configuration values.
# NEVER COMMIT .env OR REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="LoyaltyOS — Intelligent Loyalty & Ledger Management Platform"
APP_SHORT_NAME="LoyaltyOS"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG="false"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
ALLOW_ORIGIN_REGEX="^https:\/\/.*\.vercel\.app$"

# ------------------------------------------------------------------------------
# DATA TIER: SUPABASE POSTGRESQL
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Port 6543)
# Replace all placeholders using your Supabase connection details.
DATABASE_URL="postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# SUPABASE AUTH & BACKEND INTEGRATION
# ------------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-side ONLY — NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SECRET_KEY"

# Configure only if required by the backend token-verification implementation.
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
SUPABASE_JWT_ALGORITHM="HS256"

# ------------------------------------------------------------------------------
# FIREBASE AUTH & GOOGLE OAUTH INTEGRATION
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ------------------------------------------------------------------------------
# RBAC INITIAL ROLE ASSIGNMENTS
# ------------------------------------------------------------------------------
ADMIN_EMAILS="admin@example.com,manager@example.com"
OPERATOR_EMAILS="operator@example.com,warehouse@example.com"
ANALYST_EMAILS="analyst@example.com"

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (VITE SPA)
# ------------------------------------------------------------------------------
# Client-accessible variables must begin with VITE_.
# NEVER put private keys, database passwords, or service-role keys here.

VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
