# ==============================================================================
# LoyaltyOS — Intelligent Loyalty & Ledger Management Platform
# Environment Configuration Template (Phase 2)
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT .env CONTAINING REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="LoyaltyOS — Intelligent Loyalty & Ledger Management Platform"
APP_SHORT_NAME="LoyaltyOS"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG="false"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
ALLOW_ORIGIN_REGEX="^https:\/\/.*\.vercel\.app$"

# ------------------------------------------------------------------------------
# DATA TIER: SUPABASE POSTGRESQL (PHASE 2 CONFIGURATION)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Session mode, port 5432 or 6543)
# Format: postgresql+asyncpg://postgres.ahxjaplreytmauwpedgh:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# SUPABASE AUTH & BACKEND INTEGRATION (PHASE 2)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_ELzvKrq9lf9MRnfc73vvhA_qjvW-Ou2"
# Server-side ONLY — NEVER expose to frontend or git
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase JWT Secret for server-side HS256 token verification (From Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars"
SUPABASE_JWT_ALGORITHM="HS256"

# ------------------------------------------------------------------------------
# FIREBASE AUTH & GOOGLE OAUTH INTEGRATION (PHASE 2)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="loyaltyos-2a2a0"
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ------------------------------------------------------------------------------
# RBAC INITIAL ROLE ASSIGNMENTS
# ------------------------------------------------------------------------------
ADMIN_EMAILS="admin@loyaltyos.internal,manager@loyaltyos.internal"
OPERATOR_EMAILS="operator@loyaltyos.internal,warehouse@loyaltyos.internal"
ANALYST_EMAILS="analyst@loyaltyos.internal"

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (VITE SPA)
# ------------------------------------------------------------------------------
# Client-accessible variables must begin with VITE_
# NEVER put private keys, database passwords, or service-role keys in VITE_ variables!
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ELzvKrq9lf9MRnfc73vvhA_qjvW-Ou2"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="loyaltyos-2a2a0.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="loyaltyos-2a2a0"
VITE_FIREBASE_MESSAGING_SENDER_ID="179762121658"
VITE_FIREBASE_APP_ID=""
