# ==============================================================================
# YottaFlex Loyalty Ledger — Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT .env CONTAINING REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="YottaFlex Loyalty Ledger"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG="false"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins or JSON array
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.vercel.app"

# ------------------------------------------------------------------------------
# DATA TIER: SUPABASE POSTGRESQL (PHASE 2 CONFIGURATION)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Session mode, port 5432 or 6543)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=""
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# SUPABASE AUTH & BACKEND INTEGRATION (PHASE 2)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-public-anon-key"
# Server-side ONLY — NEVER expose to frontend or git
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase JWT Secret for server-side token signature verification
SUPABASE_JWT_SECRET=""

# ------------------------------------------------------------------------------
# FIREBASE AUTH & GOOGLE OAUTH INTEGRATION (PHASE 2)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Path to service account JSON file on server, OR raw JSON string in deployment
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (VITE SPA)
# ------------------------------------------------------------------------------
# Client-accessible variables must begin with VITE_
# NEVER put private keys, database passwords, or service-role keys in VITE_ variables!
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
