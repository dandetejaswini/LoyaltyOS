# ==============================================================================
# LoyaltyOS Backend (FastAPI) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment environment (e.g., Railway/Render).
# NEVER COMMIT REAL SECRETS, PRIVATE KEYS, OR DATABASE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
APP_NAME="LoyaltyOS — Intelligent Loyalty & Ledger Management Platform"
APP_SHORT_NAME="LoyaltyOS"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG="false"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
ALLOW_ORIGIN_REGEX="^https:\/\/.*\.vercel\.app$"

# Supabase PostgreSQL Database (Transaction Pooler - port 6543)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.ahxjaplreytmauwpedgh:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Supabase Auth & Storage (Server-Side Secrets)
SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_ELzvKrq9lf9MRnfc73vvhA_qjvW-Ou2"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars"
SUPABASE_JWT_ALGORITHM="HS256"

# Firebase Auth (Google OAuth Token Verification)
FIREBASE_PROJECT_ID="loyaltyos-2a2a0"
FIREBASE_SERVICE_ACCOUNT_PATH=""

# RBAC Initial Seed Administrators
ADMIN_EMAILS="admin@loyaltyos.internal,manager@loyaltyos.internal"
OPERATOR_EMAILS="operator@loyaltyos.internal,warehouse@loyaltyos.internal"
ANALYST_EMAILS="analyst@loyaltyos.internal"
