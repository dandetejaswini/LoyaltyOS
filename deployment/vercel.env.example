# ==============================================================================
# LoyaltyOS — Vercel Production Environment Variables Template
# ==============================================================================
# Configure these variables in Vercel Project Settings > Environment Variables.
#
# Architecture: Pure Supabase (PostgreSQL 15+, RPC, RLS, Edge Functions) + React Vite SPA
# All production data and business logic requests go directly to Supabase via @supabase/supabase-js.
# There is NO production Python server or secret database credentials in Vercel!
# NEVER commit private keys or service-role keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CLIENT CONFIGURATION (Client-Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project API URL
VITE_SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"

# Supabase Public Anonymous Key (or Publishable Key)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY"

# ------------------------------------------------------------------------------
# FIREBASE GOOGLE OAUTH CONFIGURATION (Optional / Client-Safe)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyC..."
VITE_FIREBASE_AUTH_DOMAIN="loyaltyos-2a2a0.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="loyaltyos-2a2a0"
VITE_FIREBASE_STORAGE_BUCKET="loyaltyos-2a2a0.firebasestorage.app"
