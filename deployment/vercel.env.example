
# ==============================================================================
# LoyaltyOS — Fullstack Vercel Deployment Environment Template
# ==============================================================================
# Configure these variables in Vercel Project Settings > Environment Variables.
#
# Frontend variables (VITE_) are bundled into client assets.
# Backend variables are server-side configuration.
# NEVER commit actual secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-Safe)
# ------------------------------------------------------------------------------
# Requires Vercel rewrites to route /api/v1 to the FastAPI backend.
VITE_API_BASE_URL="/api/v1"

# Supabase Auth Client Configuration
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Firebase Google OAuth Configuration
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# ------------------------------------------------------------------------------
# BACKEND SERVERLESS CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler connection string (Port 6543)
DATABASE_URL="postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres"

# Connection pool tuning
DB_POOL_SIZE="1"
DB_MAX_OVERFLOW="2"
DB_POOL_TIMEOUT="15"

# Supabase Auth Verification
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
SUPABASE_JWT_ALGORITHM="HS256"

# Runtime Environment
ENVIRONMENT="production"
LOG_LEVEL="INFO"
