# ==============================================================================
# LoyaltyOS — Fullstack Vercel Deployment Environment Template
# ==============================================================================
# Configure these variables in Vercel Project Settings > Environment Variables.
#
# When deploying both Frontend (Vite) and Backend (FastAPI) together on Vercel:
# - Frontend variables start with VITE_ and are bundled into client assets.
# - Backend variables are server-side only and securely injected into Python functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-Safe)
# ------------------------------------------------------------------------------
# In a unified deployment, relative path /api/v1 connects to the same domain (No CORS!)
VITE_API_BASE_URL="/api/v1"

# Supabase Auth Client Configuration
VITE_SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# Firebase Google OAuth Configuration
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="loyaltyos-2a2a0.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="loyaltyos-2a2a0"
VITE_FIREBASE_STORAGE_BUCKET="loyaltyos-2a2a0.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="179762121658"
VITE_FIREBASE_APP_ID="1:179762121658:web:94a8d4fddc71e94b21ab83"

# ------------------------------------------------------------------------------
# BACKEND SERVERLESS CONFIGURATION (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler connection string (Port 6543)
# Note: Use pooler host aws-0-ap-south-1.pooler.supabase.com:6543 for serverless functions
DATABASE_URL="postgresql+asyncpg://postgres.ahxjaplreytmauwpedgh:YOUR_ROTATED_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Connection pool tuning for serverless functions
DB_POOL_SIZE="1"
DB_MAX_OVERFLOW="2"
DB_POOL_TIMEOUT="15"

# Supabase Auth Verification (Server-Side)
SUPABASE_URL="https://ahxjaplreytmauwpedgh.supabase.co"
SUPABASE_JWT_SECRET="your-rotated-supabase-jwt-secret-min-32-chars"
SUPABASE_JWT_ALGORITHM="HS256"

# Runtime Environment
ENVIRONMENT="production"
LOG_LEVEL="INFO"
